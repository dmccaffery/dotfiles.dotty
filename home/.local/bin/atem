#!/usr/bin/env sh
# atem: run a local MediaMTX server that a Blackmagic ATEM streams to, and watch it.
#
# The ATEM publishes over SRT (preferred on Wi-Fi) or RTMP (fallback) to this
# machine on path live/atem. For SRT the ATEM must send the standard stream ID
# "#!::r=live/atem,m=publish", which needs a custom Streaming.xml (`atem xml`).
#
# `atem watch` plays over SRT with an ffplay built with libsrt: Homebrew's
# keg-only ffmpeg-full (brew:ffmpeg-full in the mise config) or any ffplay on
# PATH that has it. Without one it falls back to a loopback-only RTSP re-serve.
#
# Overrides (environment):
#   ATEM_PATH             stream path                      (default: live/atem)
#   ATEM_SRT_PORT         UDP port for SRT                 (default: 8890)
#   ATEM_SRT_PASSPHRASE   SRT encryption passphrase, 10-79 chars (default: none)
#   ATEM_RTMP_PORT        TCP port for RTMP, 0 disables    (default: 1935)
#   ATEM_RTSP_PORT        loopback RTSP port for watch     (default: 8554)
#   ATEM_LOG_LEVEL        error | warn | info | debug      (default: info)
#   ATEM_FFPLAY           ffplay binary for watch          (default: ffmpeg-full's)
#   MEDIAMTX              path to the mediamtx binary      (default: from mise)
#   ATEM_STREAMING_XML    Blackmagic's Streaming.xml, for `atem xml` profiles
set -eu

ATEM_PATH=${ATEM_PATH:-live/atem}
ATEM_SRT_PORT=${ATEM_SRT_PORT:-8890}
ATEM_SRT_PASSPHRASE=${ATEM_SRT_PASSPHRASE:-}
ATEM_RTMP_PORT=${ATEM_RTMP_PORT:-1935}
ATEM_RTSP_PORT=${ATEM_RTSP_PORT:-8554}
ATEM_LOG_LEVEL=${ATEM_LOG_LEVEL:-info}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/atem"
conf="$state_dir/mediamtx.yml"
log="$state_dir/mediamtx.log"
pidfile="$state_dir/mediamtx.pid"

prog=$(basename -- "$0")

# Heredocs are avoided throughout: macOS /bin/sh (bash 3.2) backs them with temp
# files, which fail under sandboxed agents.

usage() {
	printf '%s\n' \
		"usage: $prog <command> [flags]" \
		"" \
		"commands:" \
		"  start [--attach]      start MediaMTX (in the background unless --attach)" \
		"  stop                  stop the background server" \
		"  attach                follow the background server's log (Ctrl-C detaches)" \
		"  watch [ffplay flags]  play the stream with ffplay" \
		"  status                show whether the server is running and the ATEM settings" \
		"  xml [--out [PATH]]    print a Streaming.xml for ATEM Software Control, or" \
		"                        save it (default: ~/Desktop/Streaming.xml)"
}

die() {
	printf '%s: %s\n' "$prog" "$*" >&2
	exit 1
}

# Prints the server's pid when it is running. A pidfile whose process cannot be
# signalled is left alone rather than deleted, because a sandbox can deny the
# check for a process that is in fact still alive.
running_pid() {
	[ -f "$pidfile" ] || return 1
	pid=$(cat "$pidfile")
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
	if comm=$(ps -p "$pid" -o comm= 2>/dev/null); then
		case $comm in
		*mediamtx*) ;;
		*) return 1 ;; # pid reused by something else
		esac
	fi
	printf '%s\n' "$pid"
}

mediamtx_bin() {
	if [ -n "${MEDIAMTX:-}" ]; then
		printf '%s\n' "$MEDIAMTX"
	elif command -v mise >/dev/null 2>&1 &&
		bin=$(cd "$HOME" && mise which mediamtx 2>/dev/null); then
		printf '%s\n' "$bin"
	elif bin=$(command -v mediamtx); then
		printf '%s\n' "$bin"
	else
		die "mediamtx not found; install it with: mise install github:bluenviron/mediamtx"
	fi
}

lan_ip() {
	default_if=$(route -n get default 2>/dev/null | awk '/interface:/ { print $2 }') || true
	for iface in $default_if en0 en1 en2 en3 en4 en5 en6 en7 en8; do
		ip=$(ifconfig "$iface" 2>/dev/null | awk '/inet / { print $2; exit }') || true
		if [ -n "$ip" ]; then
			printf '%s\n' "$ip"
			return 0
		fi
	done
	printf '<mac-ip>\n'
}

ffplay_has_srt() {
	"$1" -hide_banner -protocols 2>/dev/null | awk '$1 == "srt" { found = 1 } END { exit !found }'
}

# Prints the ffplay to use: ATEM_FFPLAY, then Homebrew's keg-only ffmpeg-full
# (built with libsrt), then whatever ffplay is on PATH.
ffplay_bin() {
	if [ -n "${ATEM_FFPLAY:-}" ]; then
		printf '%s\n' "$ATEM_FFPLAY"
		return 0
	fi
	for prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
		if [ -n "$prefix" ] && [ -x "$prefix/opt/ffmpeg-full/bin/ffplay" ]; then
			printf '%s\n' "$prefix/opt/ffmpeg-full/bin/ffplay"
			return 0
		fi
	done
	command -v ffplay || die "ffplay not found; install brew:ffmpeg-full"
}

write_config() {
	if [ -n "$ATEM_SRT_PASSPHRASE" ]; then
		len=${#ATEM_SRT_PASSPHRASE}
		[ "$len" -ge 10 ] && [ "$len" -le 79 ] ||
			die "ATEM_SRT_PASSPHRASE must be 10-79 characters (got $len)"
	fi
	if [ "$ATEM_RTMP_PORT" = 0 ]; then
		rtmp=false
	else
		rtmp=true
	fi

	mkdir -p "$state_dir"
	umask 077
	printf '%s\n' \
		"# Generated by $prog on each start; edit the script or its env overrides instead." \
		"logLevel: $ATEM_LOG_LEVEL" \
		"logDestinations: [stdout]" \
		"" \
		"# SRT ingest from the ATEM, on every interface." \
		"srt: true" \
		"srtAddress: :$ATEM_SRT_PORT" \
		"" \
		"# RTMP ingest, the fallback when the ATEM cannot send an SRT stream ID." \
		"rtmp: $rtmp" \
		"rtmpAddress: :$ATEM_RTMP_PORT" \
		"" \
		"# Loopback-only RTSP so an ffplay without libsrt can watch." \
		"rtsp: true" \
		"rtspTransports: [tcp]" \
		"rtspAddress: 127.0.0.1:$ATEM_RTSP_PORT" \
		"" \
		"# Everything else off so nothing else listens." \
		"api: false" \
		"metrics: false" \
		"pprof: false" \
		"playback: false" \
		"hls: false" \
		"webrtc: false" \
		"moq: false" \
		"" \
		"paths:" \
		"  $ATEM_PATH:" \
		"    srtPublishPassphrase: \"$ATEM_SRT_PASSPHRASE\"" \
		"    srtReadPassphrase: \"$ATEM_SRT_PASSPHRASE\"" \
		>"$conf"
}

print_settings() {
	ip=$(lan_ip)
	printf '%s\n' \
		"ATEM (Output > Live Stream):" \
		"  SRT:  srt://$ip:$ATEM_SRT_PORT with stream ID #!::r=$ATEM_PATH,m=publish ($prog xml)"
	if [ -n "$ATEM_SRT_PASSPHRASE" ]; then
		echo "        passphrase from ATEM_SRT_PASSPHRASE"
	fi
	if [ "$ATEM_RTMP_PORT" != 0 ]; then
		echo "  RTMP: rtmp://$ip:$ATEM_RTMP_PORT/${ATEM_PATH%/*} with stream key ${ATEM_PATH##*/}"
	fi
	echo "watch: $prog watch"
}

# Blackmagic's stock Streaming.xml, which supplies the encoder profiles.
atem_streaming_xml() {
	for f in \
		"${ATEM_STREAMING_XML:-}" \
		"/Library/Application Support/Blackmagic Design/Switchers/Streaming.xml" \
		"/Applications/Blackmagic ATEM Switchers/ATEM Software Control.app/Contents/Resources/Streaming.xml"; do
		if [ -n "$f" ] && [ -r "$f" ]; then
			printf '%s\n' "$f"
			return 0
		fi
	done
	die "Blackmagic's Streaming.xml not found; install ATEM Software Control or set ATEM_STREAMING_XML"
}

# Prints the <profiles> block of the stock SRT service (falling back to the
# first service), so the generated file keeps Blackmagic's encoder settings.
atem_profiles() {
	awk -v want="YouTube SRT (Beta)" '
		/<service>/ { in_svc = 1; name = ""; buf = ""; grab = 0; next }
		in_svc && name == "" && /<name>/ {
			name = $0
			sub(/.*<name>/, "", name)
			sub(/<\/name>.*/, "", name)
		}
		in_svc && /<profiles>/ { grab = 1 }
		grab { buf = buf $0 "\n" }
		in_svc && /<\/profiles>/ {
			grab = 0
			if (first == "") first = buf
			if (name == want) { printf "%s", buf; found = 1; exit }
		}
		/<\/service>/ { in_svc = 0 }
		END { if (!found) printf "%s", first }
	' "$1"
}

render_xml() {
	src=$(atem_streaming_xml)
	profiles=$(atem_profiles "$src")
	[ -n "$profiles" ] || die "no <profiles> block found in $src"
	ip=$(lan_ip)
	host=$(hostname -s 2>/dev/null || echo Mac)

	printf '%s\n' \
		'<?xml version="1.0" encoding="UTF-8" ?>' \
		"<!-- Generated by $prog xml; load with ATEM Software Control > Stream > Load Streaming Settings. -->" \
		"<streaming>" \
		"	<service>" \
		"		<name>$host SRT</name>" \
		"		<servers>" \
		"			<server group=\"Primary\">" \
		"				<name>Primary</name>" \
		"				<url>srt://$ip:$ATEM_SRT_PORT</url>" \
		"				<srt-extensions>" \
		"					<stream-id>" \
		"						<item key=\"r\" value=\"$ATEM_PATH\"/>" \
		"						<item key=\"m\" value=\"publish\"/>" \
		"					</stream-id>" \
		"				</srt-extensions>" \
		"			</server>" \
		"		</servers>" \
		"$profiles" \
		"	</service>"
	if [ "$ATEM_RTMP_PORT" != 0 ]; then
		printf '%s\n' \
			"	<service>" \
			"		<name>$host RTMP</name>" \
			"		<servers>" \
			"			<server group=\"Primary\">" \
			"				<name>Primary</name>" \
			"				<url>rtmp://$ip:$ATEM_RTMP_PORT/${ATEM_PATH%/*}</url>" \
			"			</server>" \
			"		</servers>" \
			"$profiles" \
			"	</service>"
	fi
	echo "</streaming>"
}

# Prints the Streaming.xml, or with --out saves it: to a file path, into a
# directory as Streaming.xml, or to ~/Desktop/Streaming.xml when no path is given.
cmd_xml() {
	out=
	save=false
	while [ $# -gt 0 ]; do
		case $1 in
		-o | --out)
			save=true
			case ${2:-} in
			"" | -*) ;;
			*)
				out=$2
				shift
				;;
			esac
			;;
		-o=* | --out=*)
			save=true
			out=${1#*=}
			;;
		*) die "xml: unknown argument: $1" ;;
		esac
		shift
	done

	xml=$(render_xml)
	if ! $save; then
		printf '%s\n' "$xml"
		return 0
	fi

	out=${out:-$HOME/Desktop}
	if [ -d "$out" ]; then
		out="${out%/}/Streaming.xml"
	fi
	printf '%s\n' "$xml" >"$out"
	echo "wrote $out; load it with ATEM Software Control > Stream > Load Streaming Settings" >&2
}

cmd_start() {
	attach=false
	for arg in "$@"; do
		case $arg in
		-a | --attach) attach=true ;;
		*) die "start: unknown flag: $arg" ;;
		esac
	done

	if pid=$(running_pid); then
		echo "mediamtx is already running (pid $pid)"
		print_settings
		return 0
	fi

	bin=$(mediamtx_bin)
	write_config
	"$bin" --validate-conf="$conf" >/dev/null || die "generated config is invalid: $conf"

	print_settings
	if $attach; then
		echo
		exec "$bin" "$conf"
	fi

	if [ -f "$log" ]; then
		mv -f "$log" "$log.1"
	fi
	nohup "$bin" "$conf" >"$log" 2>&1 </dev/null &
	pid=$!
	echo "$pid" >"$pidfile"

	sleep 1
	if ! kill -0 "$pid" 2>/dev/null; then
		rm -f "$pidfile"
		tail -n 20 "$log" >&2
		die "mediamtx exited during startup; full log: $log"
	fi
	echo "mediamtx started in the background (pid $pid); log: $log"
}

cmd_stop() {
	if ! pid=$(running_pid); then
		rm -f "$pidfile"
		echo "mediamtx is not running"
		return 0
	fi
	kill "$pid"
	i=0
	while kill -0 "$pid" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -ge 50 ]; then
			kill -9 "$pid" 2>/dev/null || true
			break
		fi
		sleep 0.1
	done
	rm -f "$pidfile"
	echo "mediamtx stopped (pid $pid)"
}

cmd_attach() {
	pid=$(running_pid) || die "mediamtx is not running; start it with: $prog start"
	echo "following $log (pid $pid); Ctrl-C detaches, the server keeps running" >&2
	exec tail -n 50 -F "$log"
}

cmd_watch() {
	running_pid >/dev/null || die "mediamtx is not running; start it with: $prog start"
	ffplay=$(ffplay_bin)

	if ! ffplay_has_srt "$ffplay"; then
		echo "$prog: $ffplay has no SRT support (install brew:ffmpeg-full); watching over loopback RTSP" >&2
		exec "$ffplay" -hide_banner -loglevel warning \
			-window_title "ATEM ($ATEM_PATH)" \
			-fflags nobuffer -flags low_delay -framedrop \
			-rtsp_transport tcp "$@" "rtsp://127.0.0.1:$ATEM_RTSP_PORT/$ATEM_PATH"
	fi

	url="srt://127.0.0.1:$ATEM_SRT_PORT?streamid=read:$ATEM_PATH"
	if [ -n "$ATEM_SRT_PASSPHRASE" ]; then
		url="$url&passphrase=$ATEM_SRT_PASSPHRASE"
	fi

	# MediaMTX's SRT library (datarhei/gosrt) sends ACKACK control packets with
	# no payload; libsrt >= 1.5 rejects them and logs this line every ~10ms.
	# It only costs the reader its RTT estimate, so drop just that line from
	# stderr and let everything else through.
	{
		"$ffplay" -hide_banner -loglevel warning \
			-window_title "ATEM ($ATEM_PATH)" \
			-fflags nobuffer -flags low_delay -framedrop \
			"$@" "$url" 2>&1 1>&3 3>&- |
			grep --line-buffered -v 'EPE: incoming UMSG: 6 INVALID SIZE: 0' >&2 || true
	} 3>&1
}

cmd_status() {
	if pid=$(running_pid); then
		echo "mediamtx is running (pid $pid); log: $log"
		print_settings
	else
		echo "mediamtx is not running"
		return 1
	fi
}

if [ $# -eq 0 ]; then
	usage >&2
	exit 2
fi
cmd=$1
shift
case $cmd in
start) cmd_start "$@" ;;
stop) cmd_stop ;;
attach) cmd_attach ;;
watch) cmd_watch "$@" ;;
status) cmd_status ;;
xml) cmd_xml "$@" ;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
